DQAGENT_PROVIDER=openai
OPENAI_API_KEY=your-api-key
DQAGENT_MODEL=your-model-id
# OPENAI_BASE_URL=https://api.openai.com/v1
# DQAGENT_BASE_URL=https://provider-specific-endpoint/v1
#
# Local llama.cpp alternative:
# DQAGENT_PROVIDER=llama_cpp
# DQAGENT_MODEL=model-id-returned-by-v1-models
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
# LLAMA_CPP_API_KEY=optional-server-api-key
# DQAGENT_TIMEOUT_SECONDS=60
# DQAGENT_RUN_TIMEOUT_SECONDS=120
# DQAGENT_MAX_MODEL_ATTEMPTS=3
